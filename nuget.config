<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    What the build restores (all of the version of the SDK's runtime): the Native AOT compiler
    (Microsoft.DotNet.ILCompiler and its runtime.win-x64 package), Microsoft.NET.ILLink.Tasks and the
    runtime packs Microsoft.NETCore.App.Runtime.win-x64 and ...NativeAOT.win-x64. Nothing of the program
    ships a package. One source, so that a private feed in the NuGet.Config of a machine, and its
    credentials, is never asked, and a source that the machine has switched off is not needed.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>

</configuration>

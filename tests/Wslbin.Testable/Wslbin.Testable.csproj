<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The sources of the program (src\*.cs) built as a library, so that the unit tests can call them. It is the
    same code as wslbin.exe: both import Wslbin.Sources.props. Differences: WSLBIN_TESTABLE (a test must say
    which machine the code runs on, see src\Host.cs), banned APIs, and no Native AOT.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Wslbin.Testable</AssemblyName>
    <RootNamespace>Wslbin</RootNamespace>
    <DefineConstants>$(DefineConstants);WSLBIN_TESTABLE</DefineConstants>
    <!-- as wslbin.csproj: the version comes from the build, here a fixed one -->
    <VersionPrefix>0.0.0</VersionPrefix>
  </PropertyGroup>

  <Import Project="..\..\Wslbin.Sources.props" />

  <ItemGroup>
    <AdditionalFiles Include="..\BannedSymbols.Src.txt" />
    <InternalsVisibleTo Include="Wslbin.Tests.Unit" />
  </ItemGroup>

</Project>

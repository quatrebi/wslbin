<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings of Microsoft.Testing.Extensions.CodeCoverage for the unit tests (dotnet test, coverage
  and the settings option). What is measured is the program: Wslbin.Testable.dll holds
  src\*.cs. The one thing that is left out is code that a tool generated ([GeneratedCode]: the marshalling code
  of [LibraryImport]). Nothing else is excluded, on purpose: not compiler-generated code, not RealHost, and
  [ExcludeFromCodeCoverage] is banned in src\ (tests\BannedSymbols.Src.txt). tests\coverage-gate.ps1 then reads
  only the lines of files under src\.
-->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*Wslbin\.Testable\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>

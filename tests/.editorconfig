# Tests: the rules of the program, except those that only make a test harder to read.
[*.cs]
# Test_names_with_underscores, public test classes (xunit needs them), no ConfigureAwait in a test,
# a string array in a [Theory] is data and not a constant, tests catch what they must not know about
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1031.severity = none
# xunit: a test that can be cancelled is cancelled by the runner
dotnet_diagnostic.xUnit1051.severity = warning
dotnet_diagnostic.xUnit1031.severity = warning
dotnet_diagnostic.xUnit1004.severity = warning
dotnet_diagnostic.xUnit1026.severity = warning
dotnet_diagnostic.CA2016.severity = warning

# the stand-in for wsl.exe waits for a time on purpose: that is what a wsl.exe that does not answer does
[FakeWsl/Program.cs]
dotnet_diagnostic.RS0030.severity = none
